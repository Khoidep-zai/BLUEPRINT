<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="architecture_l2" name="Kiến trúc phân lớp - Luồng L2">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1144" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b style=&quot;font-size:16px&quot;&gt;SƠ ĐỒ THIẾT KẾ KIẾN TRÚC PHÂN LỚP (4-TIER LAYERED ARCHITECTURE) - LUỒNG L2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Hệ thống: Mekong Mobile CRM | Track SE | Nguyễn Bá Anh Khôi (MSSV: 2374802010247)&lt;br&gt;Phụ thuộc một chiều (tầng trên gọi tầng dưới) | Kết hợp 3 mẫu: Layered + MVC + Repository&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="15" width="1080" height="64" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="96" width="1080" height="156" as="geometry" />
        </mxCell>
        <mxCell id="L1_h" value="&lt;b&gt;TẦNG 1: TRÌNH DIỄN (PRESENTATION LAYER - HTML5, Modern CSS, ES6)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontColor=#000000;align=left;fontSize=12;" vertex="1" parent="L1">
          <mxGeometry x="12" y="6" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="L1_a" value="Client Web Application&lt;br&gt;(HTML5, Modern CSS, JavaScript ES6)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="30" y="38" width="240" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L1_b" value="Màn hình 1:&lt;br&gt;Danh sách phiếu (index.html)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="290" y="38" width="240" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L1_c" value="Màn hình 2:&lt;br&gt;Tạo phiếu bảo hành (create-ticket.html)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="550" y="38" width="240" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L1_d" value="Màn hình 3:&lt;br&gt;Chi tiết &amp; chuyển trạng thái (ticket-detail.html)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L1">
          <mxGeometry x="810" y="38" width="240" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L1_n" value="MVC - View: giao diện lễ tân gồm 3 màn hình (Wireframe tại docs/wireframes.html)." style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontColor=#333333;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="L1">
          <mxGeometry x="30" y="118" width="1020" height="34" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="304" width="1080" height="156" as="geometry" />
        </mxCell>
        <mxCell id="L2_h" value="&lt;b&gt;TẦNG 2: ĐIỀU PHỐI &amp; KIỂM TRA (CONTROLLER &amp; MIDDLEWARE LAYER - Express.js)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontColor=#000000;align=left;fontSize=12;" vertex="1" parent="L2">
          <mxGeometry x="12" y="6" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="L2_a" value="TicketController &amp; CustomerController&lt;br&gt;(Express Router: /api/tickets, /api/customers)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L2">
          <mxGeometry x="30" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L2_b" value="ValidateMiddleware&lt;br&gt;(Kiểm tra rỗng / format đầu vào)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L2">
          <mxGeometry x="380" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L2_c" value="ErrorHandlerMiddleware&lt;br&gt;(Xử lý lỗi tập trung)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L2">
          <mxGeometry x="730" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L2_n" value="Trách nhiệm: định tuyến API, kiểm tra rỗng/format đầu vào, chuyển tiếp DTO xuống tầng dưới. KHÔNG ĐƯỢC: chứa quy tắc nghiệp vụ, truy vấn CSDL trực tiếp." style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontColor=#333333;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="L2">
          <mxGeometry x="30" y="118" width="1020" height="34" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="512" width="1080" height="156" as="geometry" />
        </mxCell>
        <mxCell id="L3_h" value="&lt;b&gt;TẦNG 3: NGHIỆP VỤ CỐT LÕI (BUSINESS SERVICE LAYER)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontColor=#000000;align=left;fontSize=12;" vertex="1" parent="L3">
          <mxGeometry x="12" y="6" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="L3_a" value="TicketService&lt;br&gt;(Quản lý vòng đời phiếu - QT-06)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="30" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L3_b" value="SLACalculator&lt;br&gt;(Tính hạn cam kết SLA - QT-04)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="380" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L3_c" value="PhoneHelper&lt;br&gt;(Chuẩn hóa SĐT chống trùng - QT-01)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L3">
          <mxGeometry x="730" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L3_n" value="TOÀN BỘ quy tắc nghiệp vụ (QT-01 đến QT-06) chỉ nằm tại tầng này; điều phối Transaction (BEGIN...COMMIT: UPDATE ticket + INSERT ticket_status_log - NFR3). KHÔNG ĐƯỢC: biết công nghệ lưu trữ (SQL, Prisma, In-Memory)." style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontColor=#333333;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="L3">
          <mxGeometry x="30" y="118" width="1020" height="34" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="" style="rounded=0;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="1080" height="156" as="geometry" />
        </mxCell>
        <mxCell id="L4_h" value="&lt;b&gt;TẦNG 4: TRUY XUẤT DỮ LIỆU &amp; LƯU TRỮ (DATA ACCESS &amp; PERSISTENCE LAYER)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;fontColor=#000000;align=left;fontSize=12;" vertex="1" parent="L4">
          <mxGeometry x="12" y="6" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="L4_a" value="ITicketRepository (giao diện trừu tượng)&lt;br&gt;PgTicketRepository (chạy thật) · MockTicketRepository (Unit Test)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L4">
          <mxGeometry x="30" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L4_b" value="TicketRepository · CustomerRepository&lt;br&gt;DeviceRepository · StatusLogRepository&lt;br&gt;(prototype: cài đặt in-memory)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L4">
          <mxGeometry x="380" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L4_c" value="PostgreSQL 15 Engine&lt;br&gt;customer, device, ticket, issue_category, ticket_status_log" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.25;fontColor=#000000;fontSize=11;" vertex="1" parent="L4">
          <mxGeometry x="730" y="38" width="320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="L4_n" value="Trách nhiệm: thực thi CRUD, che giấu chi tiết SQL, quản lý Database Transaction. Repository Pattern cho phép hoán đổi Pg / Mock khi kiểm thử." style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontColor=#333333;align=left;fontSize=10;fontStyle=2;" vertex="1" parent="L4">
